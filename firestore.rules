rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Helpers
    function isValidPublicPlayerProfile(data) {
      return data.keys().hasAll([
        'uid', 'playerId', 'username', 'countryCode', 'countryFlag',
        'xp', 'level', 'coins', 'monthlyPoints', 'rating',
        'vipTier', 'fairPlayScore', 'onlineWins', 'totalMatches',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'playerId', 'username', 'countryCode', 'countryFlag',
        'xp', 'level', 'coins', 'monthlyPoints', 'rating',
        'vipTier', 'fairPlayScore', 'onlineWins', 'totalMatches',
        'isBanned', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.playerId is string && data.playerId.size() == 11 && data.playerId.matches('^#[0-9]{10}$') &&
      data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
      data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 8 &&
      data.countryFlag is string && data.countryFlag.size() >= 1 && data.countryFlag.size() <= 16 &&
      data.xp is int && data.xp >= 0 && data.xp <= 1000000000 &&
      data.level is int && data.level >= 1 && data.level <= 6 &&
      data.coins is int && data.coins >= 0 && data.coins <= 1000000000 &&
      data.monthlyPoints is int && data.monthlyPoints >= 0 && data.monthlyPoints <= 1000000000 &&
      data.rating is int && data.rating >= 0 && data.rating <= 1000000000 &&
      data.vipTier is string && data.vipTier in ['basic', 'bronze', 'silver', 'royal_gold'] &&
      data.fairPlayScore is int && data.fairPlayScore >= 0 && data.fairPlayScore <= 100 &&
      data.onlineWins is int && data.onlineWins >= 0 && data.onlineWins <= 1000000000 &&
      data.totalMatches is int && data.totalMatches >= 0 && data.totalMatches <= 1000000000 &&
      (!('isBanned' in data) || data.isBanned is bool) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPrivateUserVault(data) {
      return data.keys().hasAll(['uid', 'contactValue', 'contactType', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'contactValue', 'contactType', 'updatedAt']) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.contactValue is string && data.contactValue.size() >= 3 && data.contactValue.size() <= 120 &&
      data.contactType is string && data.contactType in ['phone', 'email'] &&
      data.updatedAt is timestamp;
    }

    function isValidPrivateRoom(data) {
      return data.keys().hasAll([
        'roomCode', 'hostUid', 'hostName', 'hostFlag',
        'guestUid', 'guestName', 'guestFlag',
        'targetPlayerId', 'category', 'questionSeed', 'questionSeeds', 'status',
        'hostScore', 'guestScore', 'hostAnsweredRound', 'guestAnsweredRound',
        'hostReadyNextRound', 'guestReadyNextRound',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'roomCode', 'hostUid', 'hostName', 'hostFlag', 'hostPlayerId',
        'guestUid', 'guestName', 'guestFlag', 'guestPlayerId',
        'targetPlayerId', 'category', 'questionSeed', 'questionSeeds', 'questionIds',
        'currentRound', 'activeTurnUid', 'status',
        'hostScore', 'guestScore', 'hostSelectedOption', 'guestSelectedOption',
        'roundWinnerUid', 'hostAnsweredRound', 'guestAnsweredRound',
        'hostReadyNextRound', 'guestReadyNextRound',
        'createdAt', 'updatedAt'
      ]) &&
      data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 32 && data.roomCode.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 && data.hostUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 32 &&
      data.hostFlag is string && data.hostFlag.size() >= 1 && data.hostFlag.size() <= 16 &&
      (!('hostPlayerId' in data) || (data.hostPlayerId is string && data.hostPlayerId.size() <= 16)) &&
      data.guestUid is string && data.guestUid.size() <= 128 &&
      data.guestName is string && data.guestName.size() <= 32 &&
      data.guestFlag is string && data.guestFlag.size() <= 16 &&
      (!('guestPlayerId' in data) || (data.guestPlayerId is string && data.guestPlayerId.size() <= 16)) &&
      data.targetPlayerId is string && data.targetPlayerId.size() <= 32 &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 32 &&
      data.questionSeed is int && data.questionSeed >= 0 &&
      data.questionSeeds is list && data.questionSeeds.size() >= 1 && data.questionSeeds.size() <= 30 &&
      (!('questionIds' in data) || (data.questionIds is list && data.questionIds.size() <= 30)) &&
      (!('currentRound' in data) || (data.currentRound is int && data.currentRound >= 0 && data.currentRound <= 30)) &&
      (!('activeTurnUid' in data) || (data.activeTurnUid is string && data.activeTurnUid.size() <= 128)) &&
      data.status is string && data.status in ['waiting', 'active', 'finished', 'completed'] &&
      data.hostScore is int && data.hostScore >= 0 && data.hostScore <= 500 &&
      data.guestScore is int && data.guestScore >= 0 && data.guestScore <= 500 &&
      (!('hostSelectedOption' in data) || (data.hostSelectedOption is int && data.hostSelectedOption >= -2 && data.hostSelectedOption <= 10)) &&
      (!('guestSelectedOption' in data) || (data.guestSelectedOption is int && data.guestSelectedOption >= -2 && data.guestSelectedOption <= 10)) &&
      (!('roundWinnerUid' in data) || (data.roundWinnerUid is string && data.roundWinnerUid.size() <= 128)) &&
      data.hostAnsweredRound is int && data.hostAnsweredRound >= 0 && data.hostAnsweredRound <= 100 &&
      data.guestAnsweredRound is int && data.guestAnsweredRound >= 0 && data.guestAnsweredRound <= 100 &&
      data.hostReadyNextRound is bool &&
      data.guestReadyNextRound is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll([
        'requestId', 'fromUid', 'fromPlayerId', 'fromName', 'fromFlag',
        'toPlayerId', 'status', 'timestamp', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'requestId', 'fromUid', 'fromPlayerId', 'fromName', 'fromFlag',
        'fromRating', 'fromVipTier',
        'toPlayerId', 'toUid', 'toName', 'toFlag', 'toRating', 'toVipTier',
        'status', 'timestamp', 'createdAt', 'updatedAt'
      ]) &&
      data.requestId is string && data.requestId.size() >= 1 && data.requestId.size() <= 128 && data.requestId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.fromUid is string && data.fromUid.size() >= 1 && data.fromUid.size() <= 128 && data.fromUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.fromPlayerId is string && data.fromPlayerId.size() >= 2 && data.fromPlayerId.size() <= 16 &&
      data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 32 &&
      data.fromFlag is string && data.fromFlag.size() >= 1 && data.fromFlag.size() <= 16 &&
      (!('fromRating' in data) || (data.fromRating is int && data.fromRating >= 0 && data.fromRating <= 1000000000)) &&
      (!('fromVipTier' in data) || (data.fromVipTier is string && data.fromVipTier in ['basic', 'bronze', 'silver', 'royal_gold'])) &&
      data.toPlayerId is string && data.toPlayerId.size() >= 2 && data.toPlayerId.size() <= 16 &&
      (!('toUid' in data) || (data.toUid is string && data.toUid.size() <= 128)) &&
      (!('toName' in data) || (data.toName is string && data.toName.size() <= 32)) &&
      (!('toFlag' in data) || (data.toFlag is string && data.toFlag.size() <= 16)) &&
      (!('toRating' in data) || (data.toRating is int && data.toRating >= 0 && data.toRating <= 1000000000)) &&
      (!('toVipTier' in data) || (data.toVipTier is string && data.toVipTier in ['basic', 'bronze', 'silver', 'royal_gold'])) &&
      data.status is string && data.status in ['pending', 'accepted', 'rejected'] &&
      data.timestamp is int && data.timestamp >= 0 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll(['senderUid', 'receiverUid', 'senderName', 'text', 'roomCode', 'createdAt']) &&
      data.keys().hasOnly(['senderUid', 'receiverUid', 'senderName', 'text', 'roomCode', 'createdAt']) &&
      data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 && data.senderUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.receiverUid is string && data.receiverUid.size() >= 1 && data.receiverUid.size() <= 128 && data.receiverUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 32 &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 300 &&
      data.roomCode is string && data.roomCode.size() <= 16 &&
      data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /players/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.monthlyPoints >= 0;

      allow create: if isValidId(userId) &&
        isValidPublicPlayerProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        isValidPublicPlayerProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().playerId == existing().playerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'username', 'countryCode', 'countryFlag',
          'xp', 'level', 'coins', 'monthlyPoints', 'rating',
          'vipTier', 'fairPlayScore', 'onlineWins', 'totalMatches', 'isBanned', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.monthlyPoints >= 0;

      allow create: if isValidId(userId) &&
        isValidPublicPlayerProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        isValidPublicPlayerProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().playerId == existing().playerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'username', 'countryCode', 'countryFlag',
          'xp', 'level', 'coins', 'monthlyPoints', 'rating',
          'vipTier', 'fairPlayScore', 'onlineWins', 'totalMatches', 'isBanned', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /user_vaults/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidPrivateUserVault(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidPrivateUserVault(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['contactValue', 'contactType', 'updatedAt']);

      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if resource.data.status in ['waiting', 'active', 'finished', 'completed'];

      allow create: if isValidId(roomId) &&
        isValidPrivateRoom(incoming()) &&
        incoming().roomCode == roomId &&
        incoming().guestUid == '' &&
        incoming().status == 'waiting' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(roomId) &&
        isValidPrivateRoom(incoming()) &&
        incoming().roomCode == existing().roomCode &&
        incoming().hostUid == existing().hostUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Guest Joins Waiting Room or Host Refreshes Waiting Room
          (
            existing().status == 'waiting' &&
            incoming().status in ['waiting', 'active'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'guestUid', 'guestName', 'guestFlag', 'guestPlayerId',
              'targetPlayerId', 'questionIds', 'currentRound', 'activeTurnUid',
              'hostSelectedOption', 'guestSelectedOption', 'roundWinnerUid',
              'status', 'updatedAt'
            ])
          ) ||
          // Action 2: Host or Guest Updates Live Match State (Turn, Round, Selected Option, Score, Readiness, Finished)
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'currentRound', 'activeTurnUid', 'questionIds',
              'hostScore', 'guestScore',
              'hostSelectedOption', 'guestSelectedOption',
              'roundWinnerUid',
              'hostAnsweredRound', 'guestAnsweredRound',
              'hostReadyNextRound', 'guestReadyNextRound',
              'status', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    match /global_matchmaking/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if resource.data.status in ['waiting', 'active', 'finished', 'completed'];

      allow create: if isValidId(roomId) &&
        isValidPrivateRoom(incoming()) &&
        incoming().roomCode == roomId &&
        incoming().guestUid == '' &&
        incoming().status == 'waiting' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(roomId) &&
        isValidPrivateRoom(incoming()) &&
        incoming().roomCode == existing().roomCode &&
        incoming().hostUid == existing().hostUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            existing().status == 'waiting' &&
            incoming().status in ['waiting', 'active'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'guestUid', 'guestName', 'guestFlag', 'guestPlayerId',
              'targetPlayerId', 'questionIds', 'currentRound', 'activeTurnUid',
              'hostSelectedOption', 'guestSelectedOption', 'roundWinnerUid',
              'status', 'updatedAt'
            ])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'currentRound', 'activeTurnUid', 'questionIds',
              'hostScore', 'guestScore',
              'hostSelectedOption', 'guestSelectedOption',
              'roundWinnerUid',
              'hostAnsweredRound', 'guestAnsweredRound',
              'hostReadyNextRound', 'guestReadyNextRound',
              'status', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    match /friend_requests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if resource.data.status in ['pending', 'accepted', 'rejected'];

      allow create: if isValidId(requestId) &&
        isValidFriendRequest(incoming()) &&
        incoming().requestId == requestId &&
        incoming().status in ['pending', 'accepted'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(requestId) &&
        isValidFriendRequest(incoming()) &&
        incoming().requestId == existing().requestId &&
        incoming().fromUid == existing().fromUid &&
        incoming().fromPlayerId == existing().fromPlayerId &&
        incoming().toPlayerId == existing().toPlayerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'toUid', 'toName', 'toFlag', 'toRating', 'toVipTier', 'timestamp', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /messages/{messageId} {
      allow get: if isSignedIn() &&
        isValidId(messageId) &&
        (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);

      allow list: if isSignedIn() &&
        (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);

      allow create: if isVerifiedUser() &&
        isValidId(messageId) &&
        isValidDirectMessage(incoming()) &&
        incoming().senderUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/players/$(request.auth.uid));

      allow update, delete: if false;
    }
  }
}
